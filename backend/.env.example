DATABASE_URL=postgresql://postgres:YOURPASSWORD@localhost:5432/dsa_tracker
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=dsa-tracker-secret-change-in-production
JWT_SECRET_KEY=dsa-tracker-jwt-secret-change-in-production
FRONTEND_URL=http://localhost:5173

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
# Optional — override the model (defaults to gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash
